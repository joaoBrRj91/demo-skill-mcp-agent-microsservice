#!/usr/bin/env bash

echo ""
echo "============================================================"
echo "  POST-COMMIT: Guardrails validation is being invoked..."
echo "  Running: validate-guardrails-implementation"
echo "============================================================"
echo ""

# Signal Claude Code's Stop hook to re-invoke the guardrails agent.
# Uses a project-relative path so Git Bash and Claude Code's shell agree on the location.
REPO_ROOT="$(git rev-parse --show-toplevel)"
mkdir -p "$REPO_ROOT/.claude/tmp"
touch "$REPO_ROOT/.claude/tmp/jl_guardrails_pending"
